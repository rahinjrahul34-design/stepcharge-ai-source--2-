# ---------------------------------------------------------------------------
# StepCharge AI — Frontend Configuration
# Copy this file to .env.local and configure for your environment.
# NEVER put private secrets (MongoDB URI, Google client secret, JWT secret) here!
# ---------------------------------------------------------------------------

# Node.js + Express REST API Base URL
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket / Socket.IO Server URL
VITE_SOCKET_URL=http://localhost:5000

# Primary Hardware Device Identifier
VITE_DEVICE_ID=ESP32-01

# Optional Direct ML API URL (leave blank to proxy through Node.js backend)
VITE_ML_API_URL=
