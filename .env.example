# ---------------------------------------------------------------------------
# StepCharge AI — frontend configuration.
# Copy to .env.local and fill in. NEVER commit real values.
#
# Only PUBLIC Firebase web-client config belongs here. Firebase web config is
# not a secret (Google documents it as public); access is controlled by the
# Security Rules in firebase.rules.json plus Firebase Authentication.
#
# The following must NEVER appear in this file or anywhere in the frontend:
#   - service-account JSON          - Firebase Admin SDK keys
#   - the Realtime Database secret  - Wi-Fi passwords
# Those belong in the ESP32's secrets.h (git-ignored) or on a server.
# ---------------------------------------------------------------------------

# --- Firebase (omit entirely to run in DEMO mode with simulated data) -------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Legacy alias for VITE_FIREBASE_DATABASE_URL (either name works).
VITE_FIREBASE_DB_URL=

# --- Device this dashboard follows ------------------------------------------
VITE_DEVICE_ID=ESP32-01

# --- scikit-learn inference service -----------------------------------------
# Leave blank to use the clearly-labelled demo heuristic instead of a model.
VITE_ML_API_URL=
