# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stepcharge?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
SESSION_COOKIE_NAME=stepcharge_session
SESSION_MAX_AGE_MS=604800000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Admin
ADMIN_EMAILS=
INITIAL_ADMIN_EMAIL=
# Optional password for the initial administrator account (minimum 8 characters).
# Set this and INITIAL_ADMIN_EMAIL explicitly to create the initial account.
INITIAL_ADMIN_PASSWORD=

# Optional password reset email delivery via Resend. Without these, local development
# prints reset links in the backend terminal; production requires both values.
PASSWORD_RESET_EMAIL_FROM=
RESEND_API_KEY=

# Device provisioning
DEFAULT_DEVICE_ID=ESP32-01
DEVICE_AUTO_PROVISION=false

# ML service
ML_SERVICE_URL=http://localhost:8000

# Socket.IO
# Socket.IO uses the same HTTP server and session cookie settings as the backend.

# CORS
# Configure the primary browser origin with FRONTEND_URL. Add any additional
# development origins to CORS_ORIGINS as a comma-separated list.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
# Cookie security is derived from NODE_ENV in the backend.

# Logging
# No backend logging environment variable is currently read by the application.

# Hardware energy constants
SUPERCAP_FARADS=0.1
MAX_STORAGE_VOLTAGE=5.0
WARN_STORAGE_VOLTAGE=4.7
LOW_STORAGE_VOLTAGE=2.0
