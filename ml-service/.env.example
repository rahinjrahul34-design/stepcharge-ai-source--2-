# ---------------------------------------------------------------------------
# StepCharge AI — ML service configuration. Copy to .env (git-ignored).
# ---------------------------------------------------------------------------

# Browser origins allowed to call this API.
# DEFAULT (if unset): http://localhost:5173,http://127.0.0.1:5173
# Set this to your real dashboard origin in any deployed environment.
# Using "*" is DEVELOPMENT ONLY and is never the default.
ALLOWED_ORIGINS=http://localhost:5173

# Where model.joblib and metadata.json are read from / written to.
MODEL_ARTIFACT_PATH=artifacts

# Default dataset CSV used by the training script.
DATASET_PATH=../stepcharge-dataset.csv
